      "name": "Validate Required Fields"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const candidate = item.json;\n\n  const degree = (candidate.Degree || \"\").toLowerCase();\n  const skills = (candidate.Skills || \"\").toLowerCase();\n  const experience = Number(candidate.Experience || 0);\n  const availability = (candidate.Availability || \"\").toLowerCase();\n\n  let score = 0;\n\n  if ([\"bsai\", \"bscs\", \"bsse\"].some(d => degree.includes(d))) {\n    score += 30;\n  }\n\n  if (skills.includes(\"python\")) score += 20;\n  if (skills.includes(\"machine learning\")) score += 20;\n  if (skills.includes(\"deep learning\")) score += 20;\n  if (skills.includes(\"sql\")) score += 10;\n\n  if (experience >= 3) score += 20;\n  else if (experience >= 1) score += 10;\n\n  if (availability.includes(\"immediate\")) score += 10;\n\n  candidate.score = score;\n\n  return { json: candidate };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -128,
        -224
      ],
      "id": "5fdda4ed-627d-45c5-a288-4502c6183768",
      "name": "Apply Screening Rules"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const candidate = item.json;\n\n  if (candidate.score >= 80) {\n    candidate.category = \"Selected\";\n    candidate.status = \"Approved\";\n    candidate.remarks = \"Excellent Match\";\n  } else if (candidate.score >= 50) {\n    candidate.category = \"Review\";\n    candidate.status = \"Pending\";\n    candidate.remarks = \"Needs Manual Review\";\n  } else {\n    candidate.category = \"Rejected\";\n    candidate.status = \"Rejected\";\n    candidate.remarks = \"Below Requirements\";\n  }\n\n  return { json: candidate };\n});"
      },
